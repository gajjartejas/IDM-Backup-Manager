# ==========================================
# IDM Backup Manager - Git Ignore Rules
# ==========================================

# Binaries and compiled libraries
*.exe
*.dll
*.sys
*.bin
*.msi

# Compressed archives
*.7z
*.zip
*.rar
*.tar
*.gz

# Personal / Registry dumps
*.reg

# Temporary & Editor backup files
*.bak
*.tmp
*.temp
*~
*.log
*.ini
_IS*.tmp

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# IDE & Editor metadata
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Windows & OS metadata
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Build outputs and staging directories
[Uu]tilities/
[Oo]utput/
*-cache/
bin/
dist/
scratch/
